      },
      "search-service": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/search/{**catch-all}" }
      },
      "promotion-service": {
        "ClusterId": "promotion-cluster",
        "Match": { "Path": "/api/promotion/{**catch-all}" }
      },
      "messaging-service": {
        "ClusterId": "messaging-cluster",
        "Match": { "Path": "/api/messages/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "messaging-subscriptions": {
        "ClusterId": "messaging-cluster",
        "Match": { "Path": "/api/subscriptions/{**catch-all}" },
