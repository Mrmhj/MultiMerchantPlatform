        "ClusterId": "logging-cluster",
        "Match": { "Path": "/api/log-stats/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "logging-health": {
        "ClusterId": "logging-cluster",
        "Match": { "Path": "/api/health/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
