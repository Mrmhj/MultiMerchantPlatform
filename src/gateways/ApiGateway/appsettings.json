{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-service": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "merchant-service": {
        "ClusterId": "merchant-cluster",
        "Match": { "Path": "/api/merchant/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "product-service": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/product/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "order-service": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/order/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "pay-service": {
        "ClusterId": "pay-cluster",
        "Match": { "Path": "/api/pay/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "stock-service": {
        "ClusterId": "stock-cluster",
        "Match": { "Path": "/api/stock/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8001/"
          }
        }
      },
      "merchant-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8002/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8003/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8004/"
          }
        }
      },
      "pay-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8005/"
          }
        }
      },
      "stock-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8006/"
          }
        }
      }
    }
  }
}
