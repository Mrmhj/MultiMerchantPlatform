{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "Concurrency": {
      "PermitLimit": 500,
      "QueueLimit": 200
    },
    "FixedWindow": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 20
    },
    "TokenBucket": {
      "TokenLimit": 2000,
      "TokensPerPeriod": 1000,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 50
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-service": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
