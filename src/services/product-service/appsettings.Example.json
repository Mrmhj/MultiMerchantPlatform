{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ProductDb": "Server=localhost;Database=MMP_Product;User Id=sa;Password=__DB_PASSWORD__;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "__JWT_SECRET__",
    "Issuer": "MultiMerchantPlatform",
    "Audience": "MultiMerchantPlatform Clients",
    "ExpiryMinutes": 120
  },
  "Internal": {
    "Key": "__INTERNAL_KEY__"
  },
  "Cache": {
    "UseRedis": true,
    "RedisConnection": "localhost:6379,password=__REDIS_PASSWORD__,abortConnect=false"
  },
  "Services": {
    "MerchantService": {
      "BaseUrl": "http://localhost:8002"
    },
    "SearchService": {
      "BaseUrl": "http://localhost:8008"
    }
  }
}
