{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationDb": "Server=localhost;Database=MMP_Notification;User Id=sa;Password=__DB_PASSWORD__;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "SecretKey": "__JWT_SECRET__",
    "Issuer": "MultiMerchantPlatform",
    "Audience": "MultiMerchantPlatform Clients",
    "ExpiryMinutes": 120
  },
  "Internal": {
    "Key": "__INTERNAL_KEY__"
  },
  "Notification": {
    "SmsDryRun": true,
    "PushDryRun": true,
    "RetentionDays": 180
  }
}
