{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PromotionDb": "Server=localhost;Database=MMP_Promotion;User Id=sa;Password=__DB_PASSWORD__;TrustServerCertificate=True;Encrypt=False"
  },
  "Cache": {
    "UseRedis": true,
    "RedisConnection": "localhost:6379,password=__REDIS_PASSWORD__,abortConnect=false"
  },
  "MessageBus": {
    "BaseUrl": "http://localhost:8010",
    "TimeoutSeconds": 10
  },
  "Jwt": {
    "SecretKey": "__JWT_SECRET__",
    "Issuer": "MultiMerchantPlatform",
    "Audience": "MultiMerchantPlatform Clients",
    "ExpiryMinutes": 120
  },
  "Internal": {
    "Key": "__INTERNAL_KEY__"
  }
}
